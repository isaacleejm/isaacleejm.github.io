# Copy this template to server/.env yourself and enter your own key there.
# Keep real credentials out of Git and VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local defaults. Production uses injected variables, not this file.
# Set NODE_ENV=production in the hosting environment.
PORT=3001
HOST=
# Production requires exact, comma-separated origins, without trailing slashes.
# CHAT_ALLOWED_ORIGINS=https://isaacleejm.github.io
CHAT_ALLOWED_ORIGINS=
# Keep zero until the deployment's trusted proxy topology is known.
TRUST_PROXY_HOPS=0
